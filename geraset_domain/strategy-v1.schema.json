        "slot": {
          "maximum": 4,
          "minimum": 1,
          "title": "Slot",
          "type": "integer"
        },
        "purpose": {
          "default": "entry",
          "enum": [
            "entry",
            "exit"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "timeframe": {
          "default": "current",
