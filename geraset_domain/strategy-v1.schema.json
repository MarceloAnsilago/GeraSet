    "ExecutionContext": {
      "additionalProperties": false,
      "description": "A resolved execution context, never emitted as an EA input.",
      "properties": {
        "symbol": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.@#$-]+$",
          "title": "Symbol",
          "type": "string"
