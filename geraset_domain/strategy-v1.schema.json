      "additionalProperties": false,
      "properties": {
        "target_unit": {
          "default": "points",
          "enum": [
            "points",
            "percent"
          ],
          "title": "Target Unit",
          "type": "string"
        },
        "stop_loss": {
          "discriminator": {
            "mapping": {
              "candle": "#/$defs/CandleStop",
              "fixed": "#/$defs/FixedStop"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedStop"
            },
            {
              "$ref": "#/$defs/CandleStop"
            }
          ],
          "title": "Stop Loss"
        },
        "take_profit": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedTake",
              "stop_multiple": "#/$defs/StopMultipleTake"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedTake"
            },
            {
              "$ref": "#/$defs/StopMultipleTake"
            }
          ],
          "title": "Take Profit"
        },
        "breakeven": {
          "$ref": "#/$defs/Breakeven"
