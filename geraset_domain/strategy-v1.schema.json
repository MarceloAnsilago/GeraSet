        "left": {
          "discriminator": {
            "mapping": {
              "indicator": "#/$defs/IndicatorOperand",
              "price": "#/$defs/PriceOperand"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PriceOperand"
            },
            {
              "$ref": "#/$defs/IndicatorOperand"
            }
          ],
          "title": "Left"
        },
        "comparison": {
          "enum": [
            "gt",
            "lt",
            "gte",
            "lte",
            "eq",
            "ne",
            "touch",
